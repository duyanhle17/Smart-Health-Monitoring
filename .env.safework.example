# Copy the measured values into .env on the deployment server before rebuilding.
# Distances are between DWM3000 antenna phase centres, in metres.
ANCHOR_BASELINE_M=6.00

# A known point inside the one-sided worker area, in the frontend's 0-100 map.
# It selects the correct branch of the two-circle intersection.
WORK_AREA_POINT=50,70

# Set true only after antenna-delay and baseline calibration have been checked
# against several tape-measured worker positions.
UWB_CALIBRATED=false

# Keep the last verified UWB point visible briefly during an RF dropout. The
# dashboard marks this point as stale; it is never a newly calculated fix.
UWB_FIX_HOLD_SECONDS=15

# Production dashboard: never let synthetic packets affect real zones/alerts.
SAFEWORK_ALLOW_SIMULATOR=false
