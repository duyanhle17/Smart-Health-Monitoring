# Copy the measured values into .env on the deployment server before rebuilding.
# Distances are between DWM3000 antenna phase centres, in metres.
ANCHOR_BASELINE_M=6.00

# A known point inside the one-sided worker area, in the frontend's 0-100 map.
# It selects the correct branch of the two-circle intersection.
WORK_AREA_POINT=50,70

# DW3000 ranges are slant distances. Prefer mounting all three antenna phase
# centres at the same height. If that is not possible, set the signed vertical
# anchor_i-minus-worker separation here; the solver converts calibrated slant
# ranges to floor-plane ranges. Known-point calibration distances remain slant
# distances: sqrt(horizontal^2 + height_delta^2).
UWB_D1_HEIGHT_DELTA_M=0.0
UWB_D2_HEIGHT_DELTA_M=0.0

# Set true only after antenna-delay and baseline calibration have been checked
# against several tape-measured worker positions.
UWB_CALIBRATED=false

# Keep the last verified UWB point visible briefly during an RF dropout. The
# dashboard marks this point as stale; it is never a newly calculated fix.
UWB_FIX_HOLD_SECONDS=15

# After the short orange hold, show the last measured coordinate in gray while
# the worker remains online. This is a display state, never a fresh UWB fix.
UWB_LAST_KNOWN_VISIBLE_SECONDS=60

# Set true only when the worker is physically constrained to the exact line
# between A1 and A2. It publishes an explicitly labelled 1-D estimate when a
# bounded short range pair cannot form a valid two-circle intersection.
UWB_LINE_FALLBACK=false
UWB_LINE_FALLBACK_TOLERANCE_M=0.35

# Direct two-range 2-D EKF. Use only after link calibration has been checked
# at multiple off-line tape-measured points. This requires
# UWB_LINE_FALLBACK=false. The BNO08x is a short prediction/ZUPT aid, never
# an IMU-only position source.
UWB_2D_FUSION=false
UWB_2D_RANGE_STD_M=0.18
UWB_2D_IMU_HOLD_SECONDS=1.5
UWB_2D_INNOVATION_GATE=9.21
UWB_2D_MAX_RANGE_AGE_MS=700
UWB_2D_REQUIRE_RANGE_METADATA=true
UWB_2D_MAX_IMU_AGE_MS=250

# ---------------------------------------------------------------------
#  BNO08x compass commissioning (mirror branch selection)
#  With only 2 anchors the two range circles meet at TWO mirrored points.
#  WORK_AREA_POINT statically picks one side; commissioning the BNO heading
#  lets the solver pick the branch DYNAMICALLY from the worker's own motion,
#  so a worker can move on BOTH sides of the A1->A2 line and jitter drops.
#  This branch prior needs ONLY yaw + stride (NOT the full accel frame below).
#
#  Procedure (see backend/tools/imu_commission.py to read live yaw/steps):
#   1. Stand the worker on the A1->A2 line facing directly toward anchor 2.
#      Read the steady BNO yaw -> put it in IMU_YAW_A1_TO_A2_DEG.
#   2. Walk a tape-measured distance D (e.g. 10 m) counting steps N.
#      Set IMU_STRIDE_M = D / N.
#   3. Set UWB_IMU_FUSION=true and rebuild. Walk 1 m straight along A1->A2;
#      the dashboard pdr_dx should be +~1.0 m, pdr_dy ~0. If it moves the
#      wrong way flip IMU_YAW_SIGN; if "forward" is not the sensor's 0 use
#      IMU_FORWARD_OFFSET_DEG. The IMU is a branch prior only; it never
#      publishes a coordinate and never overrides a real UWB fix.
UWB_IMU_FUSION=false
IMU_YAW_A1_TO_A2_DEG=
IMU_STRIDE_M=0.0
IMU_FORWARD_OFFSET_DEG=0.0
IMU_YAW_SIGN=1.0

# Set this true only after a full BNO08x mounting/frame commissioning. A yaw
# alignment alone cannot safely rotate body acceleration while a helmet tilts.
# Leaving it false still uses BNO stationary/turning cues to reduce UWB jitter.
IMU_ACCEL_FRAME_CALIBRATED=false

# ---------------------------------------------------------------------
#  Online Game-RV heading learner (replaces the manual IMU_YAW_A1_TO_A2_DEG
#  ritual for the magnetometer-free yaw_game field).  The backend compares the
#  worker's UWB travel direction with yaw_game on straight walks, learns the
#  offset AND the mounting sign, and only trusts itself after several segments
#  in different directions agree.  A BNO re-init (imu_epoch change) resets it.
UWB_YAW_OFFSET_LEARNER=true
# SH-2 accuracy floor for yaw_game samples (0-3). The learner's own residual
# gating is the real protection, so 1 is a sensible default.
UWB_YAW_GAME_MIN_ACCURACY=1

# Telemetry range-batch backfill: how far a backlogged (batched) range pair may
# be back-dated into the EKF / median window. Live pairs still use
# UWB_2D_MAX_RANGE_AGE_MS.
UWB_BATCH_MAX_AGE_MS=3000

# Production dashboard: never let synthetic packets affect real zones/alerts.
SAFEWORK_ALLOW_SIMULATOR=false

# Admin console protection. When set, POST /api/admin/* and scenario changes
# require the X-Admin-Pin header (the React admin page prompts for it once).
# Leave empty only on an isolated development machine.
SAFEWORK_ADMIN_PIN=

# Loss-of-vitals alarm thresholds (seconds). A tag that keeps reporting without
# a valid pulse escalates WARNING -> DANGER; a silent tag goes OFFLINE.
SAFEWORK_PULSE_WARNING_SECONDS=15
SAFEWORK_PULSE_DANGER_SECONDS=30
SAFEWORK_OFFLINE_TIMEOUT_SECONDS=60
